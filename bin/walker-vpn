#!/usr/bin/env bash
set -uo pipefail
umask 077
socket=/run/walker-vpn.sock
view=/run/walker-vpn-view
root_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..
source "$root_dir/lib/desktop.sh"
source "$root_dir/lib/session-env.sh"

call() {
    local response wait=${1:-115}
    [[ -S $socket ]] || { printf 'The walker-vpn systemd socket is unavailable.\n' >&2; return 1; }
    response=$(socat -t "$wait" -T "$((wait + 2))" - "UNIX-CONNECT:$socket") || return 1
    if jq -e '.error' <<< "$response" >/dev/null 2>&1; then
        jq -r '.error' <<< "$response" >&2
        return 1
    fi
    jq -ec . <<< "$response"
}

request() {
    local wait=115
    if [[ $1 == status ]]; then wait=2; fi
    jq -nc --arg action "$1" --arg region "${2:-}" '{$action,$region}' | call "$wait"
}

read_status() {
    if [[ -S $socket && -s $view/status.json ]]; then
        printf '%s\n' "$(< "$view/status.json")"
    else
        request status
    fi
}

notify() { notify-send -a 'PIA WireGuard' 'PIA WireGuard' "$*" || printf '%s\n' "$*" >&2; }

# Routing changes require the application to be closed. The panel reports this
# without sending signals to applications or discarding unsaved work.
choose() { return 2; }

run_protected() {
    local mode=$1 kind=$2 id=$3 header key marker job code
    local PATH=$PATH
    PATH=$(unrouted_path)
    shift 3
    [[ $mode == vpn || $mode == direct ]] || return 2
    [[ -S $socket ]] || { printf 'The walker-vpn service is unavailable.\n' >&2; return 1; }
    job=$(< /proc/sys/kernel/random/uuid)
    header=$(
        for key in "${app_session_keys[@]}"; do
            if [[ -v $key ]]; then printf '%s\0%s\0' "$key" "${!key}"; fi
        done | jq -Rsc --arg mode "$mode" --arg kind "$kind" --arg id "$id" --arg job "$job" \
            --arg region "${app_region:-host}" '
            split("\u0000") as $entries |
            (reduce range(0; ($entries | length); 2) as $n
                ({}; .[$entries[$n]] = $entries[$n+1])) as $session |
            {action:"app",$mode,$kind,app_id:$id,$job,$session,$region,argv:$ARGS.positional,
                forward_files:($ENV.WALKER_VPN_FLATPAK_OPTIONS != "true")}' --args -- "$@"
    ) || return 1
    {
        printf '%s\n' "$header"
        cat
    } | socat -t 2147483 - "UNIX-CONNECT:$socket" | {
        IFS= read -r marker || marker=
        case $marker in
            READY) ;;
            'ERROR '*|RETRY)
                if [[ -n ${launch_error_file:-} ]]; then
                    printf '%s\n' "$marker" > "$launch_error_file"
                elif [[ $marker == RETRY ]]; then
                    printf 'The app is still shutting down.\n' >&2
                else
                    printf '%s\n' "${marker#ERROR }" >&2
                fi
                return 1
                ;;
            *)
                printf 'The app could not start in its VPN namespace. Check journalctl -u "walker-vpn@*.service".\n' >&2
                return 1
                ;;
        esac
        cat
    } || return 1
    code=$(jq -nc --arg job "$job" '{action:"app-result",$job}' | call) || return 1
    [[ $code =~ ^[0-9]{1,3}$ ]] && (( code <= 255 )) || return 1
    return "$code"
}

source "$root_dir/lib/panel.sh"

case "${1:-status}" in
    sync-launchers) sync_saved_launchers ;;
    panel-status|locations-json|credentials|system-connect|system-disconnect|kill-switch-set|boot-reconnect-set|app-list-json|app-set-json) panel_command "$@" ;;
    flatpak) shift; flatpak_command "$@" ;;
    status) request status ;;
    disconnect|kill-off|kill-preview|kill-on) request "$1" ;;
    run)
        [[ $# -ge 4 && $3 == -- ]] || { printf 'Usage: walker-vpn run vpn|direct -- COMMAND [ARG…]\n' >&2; exit 2; }
        mode=$2 app_region=host
        shift 3
        run_protected "$mode" native '' "$@"
        ;;
    desktop|require-vpn|autostart)
        required_mode=
        if [[ $1 == require-vpn ]]; then required_mode=vpn; fi
        if [[ $1 == autostart ]]; then export WALKER_VPN_FLATPAK_OPTIONS=true; fi
        shift
        desktop_launch "$@"
        ;;
    restore)
        shift
        if [[ ${1:-} == --all ]]; then
            restore_all
        else
            [[ $# == 1 ]] && restore_desktop "$1"
        fi
        ;;
    *) printf 'Usage: walker-vpn [status|disconnect|kill-off|run|restore]\n' >&2; exit 2 ;;
esac
