[Unit]
Description=PIA desktop request
After=pia-guard.service
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/python3 -I /etc/pia-wireguard/control.py
StandardInput=socket
StandardOutput=journal
StandardError=journal
WorkingDirectory=/run/pia-vopono
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/run/pia-vopono/config
Environment=RUST_LOG=info
UMask=0077
TimeoutStopSec=12
