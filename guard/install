#!/usr/bin/bash
set -euo pipefail
if (( EUID != 0 || $# != 3 )); then
    echo "Use the top-level install.sh as the Plasma user." >&2
    exit 2
fi
/usr/bin/nft --check --file "$1/guard/pia-guard.nft"
bundle=$1
binary=$2
uid=$3
if [[ ! $uid =~ ^[1-9][0-9]*$ ]] || ! /usr/bin/getent passwd "$uid" >/dev/null; then
    echo "The control socket requires a non-root desktop account." >&2
    exit 2
fi

system_dir=/etc/systemd/system
socket_override="$system_dir/pia-control.socket.d/50-desktop-account.conf"
socket=/run/pia-vopono/control.sock
if [[ -S $socket && $(/usr/bin/stat -c %u -- "$socket") != "$uid" ]] ||
   { [[ -e $socket_override ]] && ! /usr/bin/grep -Fxq "SocketUser=$uid" "$socket_override"; }; then
    echo "Remove the existing system installation before transferring control to another user." >&2
    exit 1
fi

/usr/bin/install -d -o root -g root -m 0755 /etc/pia-wireguard
/usr/bin/install -o root -g root -m 0644 \
    "$bundle/pia-vopono" "$bundle/pia-ca.crt" "$bundle/guard/guard.py" \
    "$bundle/guard/control.py" "$bundle/guard/pia-guard.nft" /etc/pia-wireguard/
/usr/bin/install -o root -g root -m 0755 "$binary" /etc/pia-wireguard/vopono
/usr/bin/install -o root -g root -m 0755 "$bundle/guard/app-netns" /etc/pia-wireguard/app-netns
/usr/bin/python3 -I /etc/pia-wireguard/guard.py check

/usr/bin/install -o root -g root -m 0644 "$bundle/guard/pia-guard.service" \
    "$bundle/guard/pia-control.socket" "$bundle/guard/pia-control@.service" \
    "$bundle/guard/pia-reconnect.timer" "$bundle/guard/pia-reconnect.service" "$system_dir/"
/usr/bin/install -d -o root -g root -m 0755 "$(dirname -- "$socket_override")"
printf '[Socket]\nSocketUser=%s\n' "$uid" > "$socket_override"
if /usr/bin/systemctl cat NetworkManager.service >/dev/null 2>&1; then
    /usr/bin/install -d -o root -g root -m 0755 "$system_dir/NetworkManager.service.d"
    /usr/bin/install -o root -g root -m 0644 "$bundle/guard/NetworkManager-pia-guard.conf" \
        "$system_dir/NetworkManager.service.d/50-pia-guard.conf"
fi

/usr/bin/systemctl daemon-reload
/usr/bin/systemctl enable --now pia-guard.service pia-control.socket pia-reconnect.timer
/usr/bin/systemctl reload pia-guard.service
/usr/bin/systemctl is-active pia-guard.service pia-control.socket pia-reconnect.timer
