[Unit]
Description=PIA WireGuard system-wide leak protection
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /etc/pia-wireguard/guard.py firewall
ExecReload=/usr/bin/python3 -I /etc/pia-wireguard/guard.py firewall

[Install]
WantedBy=multi-user.target
