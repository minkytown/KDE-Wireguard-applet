destroy table inet pia_guard
table inet pia_guard {
    set peer {
        type ipv4_addr . inet_service
    }
    set bootstrap {
        type ipv4_addr . inet_service
        flags timeout
        timeout 2m
    }
    set direct {
        type iface_index . iface_index
    }

    chain output {
        type filter hook output priority -10; policy drop;
        oifname { "lo", "piadesk" } accept
        meta mark 51820 ip daddr . udp dport @peer accept
        meta skuid 0 meta mark 0x504941 ip daddr . tcp dport @bootstrap accept
        meta nfproto ipv4 meta skuid 0 udp sport 68 udp dport 67 accept
        counter drop
    }

    chain forward {
        type filter hook forward priority -10; policy drop;
        meta nfproto ipv4 meta iif . meta oif @direct accept
        meta nfproto ipv4 ct state established,related meta oif . meta iif @direct accept
        oifname "piadesk" accept
        iifname "piadesk" ct state established,related accept
        counter drop
    }
}
